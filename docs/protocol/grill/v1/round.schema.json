{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EmilienxD/harness/docs/protocol/grill/v1/round.schema.json",
  "title": "Harness hosted grill round v1",
  "$comment": "Question IDs must also be unique; option letters must be consecutive from A; recommendation must name one option.",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "image_command": { "type": "string", "minLength": 1, "maxLength": 8000, "$comment": "Publisher-supplied actual installed helper invocation; authors omit it." },
    "image_shell": { "enum": ["powershell", "sh"], "$comment": "Publisher-supplied command shell." },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "explanation_html", "recommendation", "options"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
          "question": { "type": "string", "minLength": 1 },
          "explanation_html": {
            "type": "string", "minLength": 1,
            "description": "HTML. Editable Mermaid uses <figure data-grill-diagram=\"stable-id\"><pre class=\"mermaid\">HTML-escaped source</pre><figcaption>Caption</figcaption></figure>. IDs match ^[A-Za-z][A-Za-z0-9_-]{0,63}$ and are unique within each question; source and caption are nonempty direct children. Existing HTML and optional init_js remain supported."
          },
          "recommendation": { "type": "string", "pattern": "^[A-D]$" },
          "init_js": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["letter", "label", "detail"],
              "properties": {
                "letter": { "type": "string", "pattern": "^[A-D]$" },
                "label": { "type": "string", "minLength": 1 },
                "detail": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
