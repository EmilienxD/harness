{
  "name": "aboard",
  "displayName": "aboard",
  "publisher": "aboard",
  "description": "Visible, human-in-the-loop orchestration for Claude Code agents in VS Code.",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/EmilienxD/aboard.git"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aboard.resumeManager",
        "title": "Aboard: Resume Previous Manager"
      },
      {
        "command": "aboard.newManager",
        "title": "Aboard: New Manager"
      },
      {
        "command": "aboard.initializeProject",
        "title": "Aboard: Initialize Project"
      },
      {
        "command": "aboard.updateProject",
        "title": "Aboard: Update Project Assets",
        "icon": "$(sync)"
      },
      {
        "command": "aboard.reviewPr",
        "title": "Aboard: Review Pull Request"
      },
      {
        "command": "aboard.focusAgent",
        "title": "Aboard: Focus Agent"
      },
      {
        "command": "aboard.killAgent",
        "title": "Aboard: Kill Agent"
      },
      {
        "command": "aboard.forceReleaseLease",
        "title": "Aboard: Force Release Write Lease"
      },
      {
        "command": "aboard.focusFleet",
        "title": "Aboard: Focus Fleet"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aboard",
          "title": "aboard",
          "icon": "assets/aboard.svg"
        }
      ]
    },
    "views": {
      "aboard": [
        {
          "id": "aboard.welcome",
          "name": "Get Started",
          "when": "!aboard.initialized"
        },
        {
          "id": "aboard.manager",
          "name": "Manager",
          "when": "aboard.initialized"
        },
        {
          "id": "aboard.fleet",
          "name": "Fleet",
          "when": "aboard.initialized"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aboard.welcome",
        "contents": "aboard runs delegated Claude Code work in visible, independent terminals, coordinated by a long-lived Manager.\n\nGitHub keeps the durable work state, and you stay in control of the decisions that matter.\n\nInitializing installs the aboard agents, skills, and hooks into this workspace and registers the local MCP bridge.\n[Initialize](command:aboard.initializeProject)"
      },
      {
        "view": "aboard.fleet",
        "contents": "No agents yet. Agents the Manager launches appear here."
      },
      {
        "view": "aboard.manager",
        "when": "aboard.managerResumable",
        "contents": "[Resume Previous Manager](command:aboard.resumeManager)"
      },
      {
        "view": "aboard.manager",
        "contents": "[+ New Manager](command:aboard.newManager)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aboard.updateProject",
          "when": "view == aboard.manager",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "aboard.initializeProject",
          "when": "!aboard.initialized"
        },
        {
          "command": "aboard.updateProject",
          "when": "aboard.initialized"
        },
        {
          "command": "aboard.resumeManager",
          "when": "aboard.managerResumable && !aboard.managerLive"
        },
        {
          "command": "aboard.newManager",
          "when": "!aboard.managerLive"
        },
        {
          "command": "aboard.focusAgent",
          "when": "false"
        },
        {
          "command": "aboard.killAgent",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "aboard.focusAgent",
          "when": "viewItem =~ /aboard.agent/"
        },
        {
          "command": "aboard.killAgent",
          "when": "viewItem == aboard.agent.active"
        }
      ]
    },
    "configuration": {
      "title": "aboard",
      "properties": {
        "aboard.bridge.port": {
          "type": "integer",
          "default": 4823,
          "minimum": 0,
          "maximum": 65535,
          "description": "Preferred loopback port. If occupied, aboard selects an ephemeral port."
        },
        "aboard.launch.maxInlinePromptChars": {
          "type": "integer",
          "default": 4000,
          "minimum": 0,
          "description": "Longest prompt passed inline as a command-line argument. Longer prompts spill to .aboard/runtime/prompts and are referenced with @path."
        },
        "aboard.workers.permissionMode": {
          "type": "string",
          "enum": [
            "bypass",
            "acceptEdits",
            "default"
          ],
          "enumDescriptions": [
            "Launch workers with --dangerously-skip-permissions. Required for unattended afk work.",
            "Launch workers with --permission-mode acceptEdits.",
            "Launch workers with Claude Code's default permission behaviour."
          ],
          "default": "default",
          "description": "Permission mode for worker launches. Applied per process; aboard never writes a permissions block into .claude/settings.json."
        },
        "aboard.manager.toolPreset": {
          "type": "string",
          "enum": [
            "read-only",
            "delegation-only"
          ],
          "default": "read-only"
        },
        "aboard.manager.disallowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "aboard.review.autoReview": {
          "type": "string",
          "enum": [
            "never",
            "hitl",
            "all"
          ],
          "default": "never",
          "description": "Controls the sole automatic review path. Explicit review actions are always available."
        },
        "aboard.timeouts.managerStop": {
          "type": "integer",
          "default": 3600,
          "minimum": 1,
          "maximum": 86400,
          "description": "Manager Stop hook and foreground MCP timeout in seconds."
        },
        "aboard.timeouts.managerPrompt": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 600,
          "description": "Manager UserPromptSubmit hook timeout in seconds."
        },
        "aboard.timeouts.managerSessionStart": {
          "type": "integer",
          "default": 120,
          "minimum": 1,
          "maximum": 3600,
          "description": "Manager SessionStart briefing timeout in seconds."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/extension.js.map",
    "assets/aboard.svg",
    "assets/scaffold/",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outfile=dist/extension.js --sourcemap",
    "check": "tsc --noEmit",
    "test:build": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist/test",
    "test": "npm run test:build && node --test dist/test/*.test.js",
    "test:integration": "npm run test && npm run test:vscode",
    "test:vscode:build": "esbuild test/vscode/run.ts test/vscode/suite.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outdir=dist/vscode-test",
    "test:vscode": "npm run build && npm run test:vscode:build && node dist/vscode-test/run.js",
    "package:build": "esbuild scripts/package.ts --bundle --packages=external --platform=node --format=cjs --target=node22 --outfile=dist/package.js",
    "package": "npm run check && npm run build -- --minify && npm run package:build && node dist/package.js"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.6.2"
}
