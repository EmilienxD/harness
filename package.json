{
  "name": "aboard",
  "displayName": "aboard",
  "description": "Visible, human-in-the-loop orchestration for Claude Code agents in VS Code.",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      { "command": "aboard.startManager", "title": "Aboard: Start Manager" },
      { "command": "aboard.resumeManager", "title": "Aboard: Resume Manager" },
      { "command": "aboard.newManager", "title": "Aboard: New Manager" },
      { "command": "aboard.scaffoldProject", "title": "Aboard: Install or Upgrade Project Assets" },
      { "command": "aboard.reviewPr", "title": "Aboard: Review Pull Request" }
    ],
    "configuration": {
      "title": "aboard",
      "properties": {
        "aboard.bridge.port": {
          "type": "integer",
          "default": 4823,
          "minimum": 0,
          "maximum": 65535,
          "description": "Preferred loopback port. If occupied, aboard selects an ephemeral port."
        },
        "aboard.launch.maxInlinePromptChars": {
          "type": "integer",
          "default": 4000,
          "minimum": 0,
          "description": "Longest prompt passed inline as a command-line argument. Longer prompts spill to .aboard/runtime/prompts and are referenced with @path."
        },
        "aboard.workers.permissionMode": {
          "type": "string",
          "enum": [
            "bypass",
            "acceptEdits",
            "default"
          ],
          "enumDescriptions": [
            "Launch workers with --dangerously-skip-permissions. Required for unattended afk work.",
            "Launch workers with --permission-mode acceptEdits.",
            "Launch workers with Claude Code's default permission behaviour."
          ],
          "default": "default",
          "description": "Permission mode for worker launches. Applied per process; aboard never writes a permissions block into .claude/settings.json."
        }
        ,"aboard.manager.toolPreset": { "type": "string", "enum": ["read-only", "delegation-only"], "default": "read-only" }
        ,"aboard.manager.disallowedTools": { "type": "array", "items": { "type": "string" }, "default": [] }
        ,"aboard.review.autoReview": { "type": "string", "enum": ["never", "hitl", "all"], "default": "never", "description": "Controls the sole automatic review path. Explicit review actions are always available." }
      }
    }
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "files": ["dist/extension.js", "dist/extension.js.map", "assets/scaffold/", "README.md"],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outfile=dist/extension.js --sourcemap",
    "check": "tsc --noEmit",
    "test:build": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist/test",
    "test": "npm run test:build && node --test dist/test/*.test.js",
    "package": "npm run check && npm run build -- --minify"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.125.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.6.2"
}
