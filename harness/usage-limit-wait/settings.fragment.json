{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/usage_limit_wait_hook.py", "--notify"],
            "timeout": 120,
            "statusMessage": "Checking Claude usage limits"
          },
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/usage_limit_wait_hook.py", "--wait"],
            "timeout": 604800,
            "statusMessage": "Waiting for the Claude usage limit to reset"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/usage_limit_wait_hook.py", "--notify"],
            "timeout": 120,
            "statusMessage": "Checking Claude usage limits"
          },
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/usage_limit_wait_hook.py", "--wait"],
            "timeout": 604800,
            "statusMessage": "Waiting for the Claude usage limit to reset"
          }
        ]
      }
    ]
  }
}
