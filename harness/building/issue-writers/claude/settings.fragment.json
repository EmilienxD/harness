{
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${CLAUDE_DIR}/hooks/issue_writers_hook.py", "--claude"]}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${CLAUDE_DIR}/hooks/issue_writers_hook.py", "--claude"]}]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${CLAUDE_DIR}/hooks/issue_writers_hook.py", "--claude"]}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${CLAUDE_DIR}/hooks/issue_writers_hook.py", "--claude"]}]}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/issue_writers_hook.py", "--claude"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
