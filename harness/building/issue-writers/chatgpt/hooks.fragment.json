{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/issues_ChatGPT_hook.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/issues_ChatGPT_hook.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/issues_ChatGPT_hook.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
