{
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${CLAUDE_DIR}/hooks/copy_message_as_issue.py"]}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${CLAUDE_DIR}/hooks/copy_message_as_issue.py"]}]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${CLAUDE_DIR}/hooks/copy_message_as_issue.py"]}]}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/publish_issues_UserPromptSubmit_hook.py"],
            "timeout": 300
          },
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/address_issue_UserPromptSubmit_hook.py"],
            "timeout": 120
          },
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/review_issue_UserPromptSubmit_hook.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
