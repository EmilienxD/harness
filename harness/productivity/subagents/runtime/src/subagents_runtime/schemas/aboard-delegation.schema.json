{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/aboard-delegation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "task",
    "provider",
    "mode",
    "prompt",
    "cwd"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "explore",
        "prototype",
        "websearch",
        "brainstorm",
        "address",
        "review",
        "general",
        "loop"
      ]
    },
    "provider": {
      "enum": [
        "claude",
        "chatgpt"
      ]
    },
    "mode": {
      "enum": [
        "interactive",
        "auto",
        "loop"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit model ID for this child; omitted requests retain the task's launch profile."
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "harnessSessionId": {
      "type": "string",
      "minLength": 1
    },
    "harnessStateDirectory": {
      "type": "string",
      "minLength": 1
    },
    "harnessRuntimePath": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "parentSessionId": {
      "type": "string",
      "minLength": 1
    },
    "resumeAgentId": {
      "type": "string",
      "minLength": 1
    },
    "resumeSessionId": {
      "type": "string",
      "minLength": 1
    },
    "harnessPython": {
      "type": "string",
      "minLength": 1
    },
    "forkSessionId": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "routine",
        "basic",
        "advanced",
        "expert"
      ]
    }
  },
  "if": {
    "properties": {
      "task": {
        "const": "prototype"
      }
    },
    "required": [
      "task"
    ]
  },
  "then": {
    "properties": {
      "mode": {
        "const": "interactive"
      }
    }
  }
}
