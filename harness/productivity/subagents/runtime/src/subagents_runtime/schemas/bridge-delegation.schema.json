{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/bridge-delegation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "provider",
    "mode",
    "prompt",
    "cwd"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "claude",
        "chatgpt",
        "pi"
      ]
    },
    "mode": {
      "enum": [
        "interactive",
        "auto",
        "loop"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit model ID; omitted requests retain the general delegation profile and native defaults."
    },
    "effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ],
      "description": "Requested reasoning effort. Omit to retain the launch profile and native defaults. The runtime silently selects the nearest level supported by the model."
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "harnessSessionId": {
      "type": "string",
      "minLength": 1
    },
    "harnessStateDirectory": {
      "type": "string",
      "minLength": 1
    },
    "harnessRuntimePath": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "parentSessionId": {
      "type": "string",
      "minLength": 1
    },
    "resumeAgentId": {
      "type": "string",
      "minLength": 1
    },
    "resumeSessionId": {
      "type": "string",
      "minLength": 1
    },
    "harnessPython": {
      "type": "string",
      "minLength": 1
    },
    "forkSessionId": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "routine",
        "basic",
        "advanced",
        "expert"
      ]
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Optional explicit user-requested child skill. Missing skills fail before launch."
    }
  }
}
