{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/delegation-request.schema.json",
  "title": "Delegation request frontmatter",
  "description": "The YAML frontmatter of a request file. The prompt is the nonempty Markdown body that follows the frontmatter, not a frontmatter key.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "description": "Defaults to the parent session's provider when omitted. 'codex' is an alias of 'chatgpt' and is normalized to it.",
      "enum": [
        "claude",
        "chatgpt",
        "codex",
        "pi"
      ]
    },
    "mode": {
      "enum": [
        "interactive",
        "auto",
        "loop"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit model ID; omitted requests retain the general delegation profile and native defaults."
    },
    "effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ],
      "description": "Requested reasoning effort. Omit to retain the launch profile and native defaults. The runtime silently selects the nearest level supported by the model."
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "description": "Optional child working directory, absolute or relative to the parent session directory. Must exist. Omit to inherit the parent root."
    },
    "resume": {
      "type": "string",
      "pattern": "^agent-[1-9][0-9]*$"
    },
    "difficulty": {
      "enum": [
        "routine",
        "basic",
        "advanced",
        "expert"
      ]
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "prompt-file": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Optional explicit user-requested child skill. Missing skills fail before launch."
    }
  },
  "oneOf": [
    {
      "required": [
        "mode"
      ],
      "not": {
        "required": [
          "resume"
        ]
      }
    },
    {
      "required": [
        "resume"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "skill"
            ]
          },
          {
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "provider"
            ]
          },
          {
            "required": [
              "model"
            ]
          },
          {
            "required": [
              "root"
            ]
          },
          {
            "required": [
              "cwd"
            ]
          },
          {
            "required": [
              "difficulty"
            ]
          },
          {
            "required": [
              "prompt-file"
            ]
          },
          {
            "required": [
              "effort"
            ]
          }
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "loop"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "cwd",
          "prompt-file"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "root"
              ]
            },
            {
              "required": [
                "skill"
              ]
            }
          ]
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "cwd"
              ]
            },
            {
              "required": [
                "difficulty"
              ]
            },
            {
              "required": [
                "prompt-file"
              ]
            }
          ]
        }
      }
    }
  ]
}
