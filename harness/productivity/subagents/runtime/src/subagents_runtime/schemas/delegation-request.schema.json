{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/delegation-request.schema.json",
  "title": "Delegation request frontmatter",
  "description": "The YAML frontmatter of a request file. The prompt is the nonempty Markdown body that follows the frontmatter, not a frontmatter key.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "enum": [
        "explore",
        "prototype",
        "websearch",
        "brainstorm",
        "address",
        "review",
        "general"
      ]
    },
    "provider": {
      "description": "Defaults to the parent session's provider when omitted. 'codex' is an alias of 'chatgpt' and is normalized to it.",
      "enum": [
        "claude",
        "chatgpt",
        "codex"
      ]
    },
    "mode": {
      "enum": [
        "interactive",
        "auto"
      ]
    },
    "resume": {
      "type": "string",
      "pattern": "^agent-[1-9][0-9]*$"
    }
  },
  "oneOf": [
    {
      "required": [
        "task",
        "mode"
      ],
      "not": {
        "required": [
          "resume"
        ]
      }
    },
    {
      "required": [
        "resume"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "task"
            ]
          },
          {
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "provider"
            ]
          }
        ]
      }
    }
  ],
  "if": {
    "properties": {
      "task": {
        "const": "prototype"
      }
    },
    "required": [
      "task"
    ]
  },
  "then": {
    "properties": {
      "mode": {
        "const": "interactive"
      }
    }
  }
}
