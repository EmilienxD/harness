{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/delegation-request.schema.json",
  "title": "Delegation request frontmatter",
  "description": "The YAML frontmatter of a request file. The prompt is the nonempty Markdown body that follows the frontmatter, not a frontmatter key.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "A builtin task from subagents-toolkit, a custom task from subagent-tasks.yaml, or the internal loop task. The runtime validates registry membership and allowed modes."
    },
    "provider": {
      "description": "Defaults to the parent session's provider when omitted. 'codex' is an alias of 'chatgpt' and is normalized to it.",
      "enum": [
        "claude",
        "chatgpt",
        "codex"
      ]
    },
    "mode": {
      "enum": [
        "interactive",
        "auto",
        "loop"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit model ID, supplied only when the user requests a particular model. Omit to retain the task's launch profile and native defaults."
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "description": "Optional child working directory, absolute or relative to the parent session directory. Must exist. Omit to inherit the parent root."
    },
    "resume": {
      "type": "string",
      "pattern": "^agent-[1-9][0-9]*$"
    },
    "difficulty": {
      "enum": [
        "routine",
        "basic",
        "advanced",
        "expert"
      ]
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "prompt-file": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "task",
        "mode"
      ],
      "not": {
        "required": [
          "resume"
        ]
      }
    },
    {
      "required": [
        "resume"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "task"
            ]
          },
          {
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "provider"
            ]
          },
          {
            "required": [
              "model"
            ]
          },
          {
            "required": ["root"]
          },
          {
            "required": [
              "cwd"
            ]
          },
          {
            "required": [
              "difficulty"
            ]
          },
          {
            "required": [
              "prompt-file"
            ]
          }
        ]
      }
    }
  ],
  "if": {
    "properties": {
      "task": {
        "const": "prototype"
      }
    },
    "required": [
      "task"
    ]
  },
  "then": {
    "properties": {
      "mode": {
        "const": "interactive"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "loop"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "required": [
          "cwd",
          "prompt-file"
        ],
        "properties": {
          "mode": {
            "const": "loop"
          }
        },
        "not": {"required": ["root"]}
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "cwd"
              ]
            },
            {
              "required": [
                "difficulty"
              ]
            },
            {
              "required": [
                "prompt-file"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "loop"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "task": {
            "const": "loop"
          }
        }
      }
    }
  ]
}
