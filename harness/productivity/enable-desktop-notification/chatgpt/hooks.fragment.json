{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/enable_desktop_notification_hook.py\" --chatgpt",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/enable_desktop_notification_hook.py\" --chatgpt",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
