{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/enable_desktop_notification_hook.py", "--claude"],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "enable-desktop-notification",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/enable_desktop_notification_hook.py", "--claude"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/enable_desktop_notification_hook.py", "--claude"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
