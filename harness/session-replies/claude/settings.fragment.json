{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${HOOKS_DIR}/reply_delivery.py", "post-tool"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${HOOKS_DIR}/reply_delivery.py", "stop"],
            "timeout": 86400,
            "statusMessage": "Waiting for a visible Harness child"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${HOOKS_DIR}/reply_delivery.py", "prompt"]
          }
        ]
      }
    ]
  }
}
