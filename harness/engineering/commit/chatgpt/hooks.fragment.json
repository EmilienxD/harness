{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/commit_hook.py\" --chatgpt",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/commit_hook.py\" --chatgpt",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/commit_hook.py\" --chatgpt",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
