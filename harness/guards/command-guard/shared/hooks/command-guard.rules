# Global agent command guard — dangerous command denylist for every OS.
# One POSIX-ERE-style regex per line. Blank lines and # comments are ignored.
# Matching is case-insensitive. The hook translates [:space:] for Python's regex
# engine, which keeps the same file usable for Bash and PowerShell command text.
# Numbered section comments become the safe, non-command-text denial reason.

# 1. rm aimed at root, a whole home folder, or the whole Users tree
(^|[;&|[:space:]])rm[[:space:]]+((-[a-zA-Z]+|--[a-z-]+)[[:space:]]+)*["']?/["']?[[:space:]]*($|[;&|])
(^|[;&|[:space:]])rm[[:space:]]+((-[a-zA-Z]+|--[a-z-]+)[[:space:]]+)*["']?/\*
(^|[;&|[:space:]])rm[[:space:]]+((-[a-zA-Z]+|--[a-z-]+)[[:space:]]+)*["']?(~|\$HOME|\$\{HOME\})/?["']?[[:space:]]*($|[;&|])
(^|[;&|[:space:]])rm[[:space:]]+((-[a-zA-Z]+|--[a-z-]+)[[:space:]]+)*["']?(~|\$HOME|\$\{HOME\})/\*
(^|[;&|[:space:]])rm[[:space:]]+((-[a-zA-Z]+|--[a-z-]+)[[:space:]]+)*["']?/Users(/[^/[:space:]"']+)?/?["']?[[:space:]]*($|[;&|])
--no-preserve-root

# 2. raw-disk writes, formatting, or erasure
(^|[;&|[:space:]])dd[[:space:]][^;&|]*of=["']?/dev/
>[[:space:]]*/dev/(r?disk|sd[a-z]|nvme)
(^|[;&|[:space:]])mkfs(\.[A-Za-z0-9]+)?([[:space:]]|$)
(^|[;&|[:space:]])diskutil[[:space:]]+(erase[A-Za-z]*|partitionDisk|zeroDisk|secureErase|apfs[[:space:]]+(delete|erase)[A-Za-z]*)

# 3. deletion with administrator privileges
(^|[;&|[:space:]])sudo[[:space:]]+(-[a-zA-Z]+[[:space:]]+)*rm([[:space:]]|$)

# 4. a shell fork bomb
:\(\)[[:space:]]*\{[[:space:]]*:[[:space:]]*\|[[:space:]]*:[[:space:]]*&[[:space:]]*\}[[:space:]]*;[[:space:]]*:

# 5. network content piped directly into a shell
(^|[;&|[:space:]])(curl|wget)[[:space:]][^;&|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh([[:space:]]|$)

# 6. forced remote Git history rewrite
(^|[;&|[:space:]])git[[:space:]]+push[^;&|]*[[:space:]](-f([[:space:]]|$)|--force([=[:space:]]|$))
(^|[;&|[:space:]])git[[:space:]]+push[^;&|]*[[:space:]]\+[A-Za-z0-9._/-]

# 6b. remote Git branch or tag deletion
(^|[;&|[:space:]])git[[:space:]]+push[^;&|]*[[:space:]](--delete|-d)([[:space:]]|$)
(^|[;&|[:space:]])git[[:space:]]+push[^;&|]*[[:space:]]:[A-Za-z0-9._/-]

# 7. system-wide permission or ownership destruction
(^|[;&|[:space:]])chmod[[:space:]][^;&|]*777[[:space:]]+["']?/["']?[[:space:]]*($|[;&|])
(^|[;&|[:space:]])chown[[:space:]]+-R[^;&|]*[[:space:]]+/["']?[[:space:]]*($|[;&|])

# 8. destruction of Git's reflog safety net
(^|[;&|[:space:]])git[[:space:]]+reflog[[:space:]]+expire[^;&|]*--expire(-unreachable)?(=|[[:space:]]+)now
(^|[;&|[:space:]])git[[:space:]]+gc[^;&|]*--prune(=|[[:space:]]+)(now|all)

# 9. irreversible or account-level GitHub CLI operations and token output
(^|[;&|[:space:]])gh[[:space:]]+repo[[:space:]]+delete([[:space:]]|$)
(^|[;&|[:space:]])gh[[:space:]]+release[[:space:]]+delete([[:space:]]|$)
(^|[;&|[:space:]])gh[[:space:]]+(secret|ssh-key|gpg-key)[[:space:]]+delete([[:space:]]|$)
(^|[;&|[:space:]])gh[[:space:]]+api[[:space:]][^;&|]*(-X|--method)(=|[[:space:]]+)(DELETE|delete)
(^|[;&|[:space:]])gh[[:space:]]+repo[[:space:]]+edit[^;&|]*--visibility(=|[[:space:]]+)public
(^|[;&|[:space:]])gh[[:space:]]+auth[[:space:]]+token([[:space:]]|$)

# 10. password managers, secret keys, or operating-system keychains
(^|[;&|[:space:]])(bw|bws|lpass|keepassxc-cli|rbw|nordpass)([[:space:]]|$)
(^|[;&|])[[:space:]]*pass[[:space:]]+[^[:space:]]
(^|[;&|[:space:]])op[[:space:]]+(read|run|inject|item|document|vault|connect|service-account|events-api|signin)([[:space:]]|$)
(^|[;&|[:space:]])security[[:space:]]+((-[a-zA-Z]+|--[a-z-]+)[[:space:]]+)*(find-generic-password|find-internet-password|dump-keychain)([[:space:]]|$)
(1Password|Bitwarden|NordPass|KeePassXC)\.app
(~|\$HOME|\$\{HOME\}|/Users/[^/[:space:]"']+)/\.password-store
(^|[;&|[:space:]])open[[:space:]]+-a[[:space:]]+["']?(1[Pp]assword|[Bb]itwarden|[Nn]ord[Pp]ass|[Kk]ee[Pp]ass)
(^|[;&|[:space:]])brew[[:space:]]+(uninstall|remove|rm)[^;&|]*[[:space:]]["']?(1password|bitwarden|nordpass|keepassxc|lastpass)
--export-secret-(keys?|subkeys)([[:space:]=]|$)

# 11. PowerShell or Windows deletion aimed at a drive, profile, or Users tree
(^|[;&|[:space:]])(Remove-Item|del|erase|rd|ri|rm|rmdir)([[:space:]]|$)[^;&|]*["']?[A-Za-z]:\\(\*)?["']?[[:space:]]*($|[;&|])
(^|[;&|[:space:]])(Remove-Item|del|erase|rd|ri|rm|rmdir)([[:space:]]|$)[^;&|]*(\$env:(HOME|USERPROFILE|HOMEDRIVE)|%USERPROFILE%)[\\/]?["']?([[:space:]]|$|[;&|])
(^|[;&|[:space:]])(Remove-Item|del|erase|rd|ri|rm|rmdir)([[:space:]]|$)[^;&|]*["']?[A-Za-z]:\\Users(\\\*)?["']?([[:space:]]|$|[;&|])
(^|[;&|[:space:]])(Remove-Item|del|erase|rd|ri|rm|rmdir)([[:space:]]|$)[^;&|]*["']?\\\\[^\\[:space:]]+\\[^\\[:space:]]+\\\*["']?([[:space:]]|$|[;&|])

# 12. Windows disk formatting, initialization, or erasure
(^|[;&|[:space:]])(Format-Volume|Clear-Disk|Initialize-Disk)([[:space:]]|$)
(^|[;&|[:space:]])diskpart([[:space:]]|$)
(^|[;&|[:space:]])format(\.com)?[[:space:]]+[A-Za-z]:([[:space:]]|$)

# 13. network content piped directly into PowerShell evaluation
(^|[;&|[:space:]])(Invoke-WebRequest|Invoke-RestMethod|iwr|irm)[[:space:]][^;&|]*\|[[:space:]]*(Invoke-Expression|iex)([[:space:]]|$)

# 14. recursive Windows ownership or ACL changes at a drive root
(^|[;&|[:space:]])icacls[[:space:]]+["']?[A-Za-z]:\\["']?[^;&|]*/(T|reset)([[:space:]]|$)
(^|[;&|[:space:]])takeown[[:space:]][^;&|]*/F[[:space:]]+["']?[A-Za-z]:\\["']?[^;&|]*/R([[:space:]]|$)

# 15. Windows credential stores and PowerShell secret vaults
(^|[;&|[:space:]])((Get|Set|Remove)-Secret(Info)?|Get-StoredCredential|Register-SecretVault|Unregister-SecretVault)([[:space:]]|$)
(^|[;&|[:space:]])(cmdkey|vaultcmd)([[:space:]]|$)
(^|[;&|[:space:]])(1Password|Bitwarden|NordPass|KeePassXC)(\.exe)([[:space:]]|$)
(^|[;&|[:space:]])(secret-tool|kwallet-query)([[:space:]]|$)
