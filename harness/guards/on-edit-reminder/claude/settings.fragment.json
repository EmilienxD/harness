{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": [
              "${HOOKS_DIR}/on_edit_reminder_hook.py",
              "--claude"
            ]
          }
        ]
      }
    ]
  }
}
