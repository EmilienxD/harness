{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/usage_limit_wait_hook.py"],
            "timeout": 604800,
            "statusMessage": "Checking Claude usage limits — waits here if they are exhausted"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/usage_limit_wait_hook.py"],
            "timeout": 604800,
            "statusMessage": "Checking Claude usage limits — waits here if they are exhausted"
          }
        ]
      }
    ]
  }
}
