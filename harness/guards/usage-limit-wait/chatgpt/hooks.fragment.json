{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/usage_limit_wait_hook.py\" --chatgpt",
            "timeout": 604800,
            "statusMessage": "Checking Codex usage limits — waits here if they are exhausted"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/usage_limit_wait_hook.py\" --chatgpt",
            "timeout": 604800,
            "statusMessage": "Checking Codex usage limits — waits here if they are exhausted"
          }
        ]
      }
    ]
  }
}
