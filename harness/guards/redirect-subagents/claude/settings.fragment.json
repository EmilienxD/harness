{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/redirect_subagents_hook.py", "--claude"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/redirect_subagents_hook.py", "--claude"],
            "statusMessage": "Checking redirected background subagents"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/redirect_subagents_hook.py", "--claude"],
            "timeout": 600,
            "statusMessage": "Waiting for redirected background subagents"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/redirect_subagents_hook.py", "--claude"],
            "timeout": 600,
            "statusMessage": "Waiting for redirected background subagents"
          }
        ]
      }
    ]
  }
}
