{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/no_new_documents_hook.py", "--claude"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON}",
            "args": ["${CLAUDE_DIR}/hooks/no_new_documents_hook.py", "--claude"]
          }
        ]
      }
    ]
  }
}
