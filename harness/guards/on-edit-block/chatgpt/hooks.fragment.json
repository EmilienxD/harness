{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/on_edit_block_hook.py\" --chatgpt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PYTHON} \"${HOOKS_DIR}/on_edit_block_hook.py\" --chatgpt"
          }
        ]
      }
    ]
  }
}
