{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${HOOKS_DIR}/delegation_hook.py", "claude"]}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${HOOKS_DIR}/delegation_hook.py", "claude"]}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${HOOKS_DIR}/delegation_hook.py", "claude"]}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${HOOKS_DIR}/delegation_hook.py", "claude"]}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${HOOKS_DIR}/delegation_hook.py", "claude"], "timeout": 86400}]}],
    "StopFailure": [{"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${HOOKS_DIR}/delegation_hook.py", "claude"]}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "${PYTHON}", "args": ["${HOOKS_DIR}/delegation_hook.py", "claude"]}]}]
  }
}
