    "e2e:prefer-read-tool": "npm run e2e:prefer-read-tool:build && node dist/tools/prefer-read-tool/cli.js",
    "e2e:prefer-fewer-comments:build": "esbuild tools/prefer-fewer-comments/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/prefer-fewer-comments/cli.js --sourcemap",
    "e2e:prefer-fewer-comments": "npm run e2e:prefer-fewer-comments:build && node dist/tools/prefer-fewer-comments/cli.js",
    "e2e:report-gotchas:build": "esbuild tools/report-gotchas/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/report-gotchas/cli.js --sourcemap",
