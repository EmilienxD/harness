{
  "name": "@harness/e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "test:build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild test/*.test.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist/test && npm run e2e:subagents:bridge",
    "test": "npm run test:build && node --test dist/test/*.test.js",
    "e2e:on-edit-block:build": "esbuild tools/on-edit-block/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/on-edit-block/cli.js --sourcemap",
    "e2e:on-edit-block": "npm run e2e:on-edit-block:build && node dist/tools/on-edit-block/cli.js",
    "e2e:agent-launcher:build": "esbuild tools/agent-launcher/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/agent-launcher/cli.js --sourcemap",
    "e2e:agent-launcher": "npm run e2e:agent-launcher:build && node dist/tools/agent-launcher/cli.js",
    "e2e:on-edit-reminder:build": "esbuild tools/on-edit-reminder/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/on-edit-reminder/cli.js --sourcemap",
    "e2e:on-edit-reminder": "npm run e2e:on-edit-reminder:build && node dist/tools/on-edit-reminder/cli.js",
    "e2e:on-read-reminder:build": "esbuild tools/on-read-reminder/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/on-read-reminder/cli.js --sourcemap",
    "e2e:on-read-reminder": "npm run e2e:on-read-reminder:build && node dist/tools/on-read-reminder/cli.js",
    "e2e:no-new-documents:build": "esbuild tools/no-new-documents/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/no-new-documents/cli.js --sourcemap",
    "e2e:no-new-documents": "npm run e2e:no-new-documents:build && node dist/tools/no-new-documents/cli.js",
    "e2e:command-guard:build": "esbuild tools/command-guard/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/command-guard/cli.js --sourcemap",
    "e2e:command-guard": "npm run e2e:command-guard:build && node dist/tools/command-guard/cli.js",
    "e2e:issue-readers:build": "esbuild tools/issue-readers/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/issue-readers/cli.js --sourcemap",
    "e2e:issue-readers": "npm run e2e:issue-readers:build && node dist/tools/issue-readers/cli.js",
    "e2e:issue-writers:build": "esbuild tools/issue-writers/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/issue-writers/cli.js --sourcemap",
    "e2e:issue-writers": "npm run e2e:issue-writers:build && node dist/tools/issue-writers/cli.js",
    "e2e:breakdown-help-wanted-issue:build": "esbuild tools/breakdown-help-wanted-issue/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/breakdown-help-wanted-issue/cli.js --sourcemap",
    "e2e:breakdown-help-wanted-issue": "npm run e2e:breakdown-help-wanted-issue:build && node dist/tools/breakdown-help-wanted-issue/cli.js",
    "e2e:prefer-edit-tool:build": "esbuild tools/prefer-edit-tool/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/prefer-edit-tool/cli.js --sourcemap",
    "e2e:prefer-edit-tool": "npm run e2e:prefer-edit-tool:build && node dist/tools/prefer-edit-tool/cli.js",
    "e2e:prefer-fewer-comments:build": "esbuild tools/prefer-fewer-comments/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/prefer-fewer-comments/cli.js --sourcemap",
    "e2e:prefer-fewer-comments": "npm run e2e:prefer-fewer-comments:build && node dist/tools/prefer-fewer-comments/cli.js",
    "e2e:prefer-read-tool:build": "esbuild tools/prefer-read-tool/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/prefer-read-tool/cli.js --sourcemap",
    "e2e:prefer-read-tool": "npm run e2e:prefer-read-tool:build && node dist/tools/prefer-read-tool/cli.js",
    "e2e:report-gotchas:build": "esbuild tools/report-gotchas/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/report-gotchas/cli.js --sourcemap",
    "e2e:report-gotchas": "npm run e2e:report-gotchas:build && node dist/tools/report-gotchas/cli.js",
    "e2e:commit:build": "esbuild tools/commit/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/commit/cli.js --sourcemap",
    "e2e:commit": "npm run e2e:commit:build && node dist/tools/commit/cli.js",
    "e2e:usage-limit-wait:build": "esbuild tools/usage-limit-wait/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/usage-limit-wait/cli.js --sourcemap",
    "e2e:usage-limit-wait": "npm run e2e:usage-limit-wait:build && node dist/tools/usage-limit-wait/cli.js",
    "e2e:subagents:bridge": "esbuild tools/subagents/cli-bridge.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/subagents/cli-bridge.js",
    "e2e:subagents:build": "npm run e2e:subagents:bridge && esbuild tools/subagents/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/subagents/cli.js --sourcemap",
    "e2e:subagents": "npm run e2e:subagents:build && node dist/tools/subagents/cli.js",
    "e2e:redirect-subagents:build": "esbuild tools/redirect-subagents/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/redirect-subagents/cli.js --sourcemap",
    "e2e:redirect-subagents": "npm run e2e:redirect-subagents:build && node dist/tools/redirect-subagents/cli.js"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.6.2"
}
