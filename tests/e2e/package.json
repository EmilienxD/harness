{
  "name": "@harness/e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "test:build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild test/*.test.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist/test",
    "test": "npm run test:build && node --test dist/test/*.test.js",
    "e2e:on-edit-block:build": "esbuild tools/on-edit-block/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/on-edit-block/cli.js --sourcemap",
    "e2e:on-edit-block": "npm run e2e:on-edit-block:build && node dist/tools/on-edit-block/cli.js",
    "e2e:no-new-documents:build": "esbuild tools/no-new-documents/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/no-new-documents/cli.js --sourcemap",
    "e2e:no-new-documents": "npm run e2e:no-new-documents:build && node dist/tools/no-new-documents/cli.js",
    "e2e:report-gotchas:build": "esbuild tools/report-gotchas/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/report-gotchas/cli.js --sourcemap",
    "e2e:report-gotchas": "npm run e2e:report-gotchas:build && node dist/tools/report-gotchas/cli.js"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.6.2"
}
