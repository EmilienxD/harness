{
  "name": "@harness/e2e",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "e2e:flush-out-useless-tests:build": "esbuild tools/flush-out-useless-tests/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/flush-out-useless-tests/cli.js",
    "e2e:flush-out-useless-tests": "npm run e2e:flush-out-useless-tests:build && node dist/tools/flush-out-useless-tests/cli.js",
    "test:flush-out-useless-tests": "esbuild test/flush-out-useless-tests.test.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/test/flush-out-useless-tests.test.js && node --test dist/test/flush-out-useless-tests.test.js",
    "e2e:pi:build": "esbuild tools/pi-smoke/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/tools/pi-smoke/cli.js",
    "e2e:pi": "npm run e2e:pi:build && node dist/tools/pi-smoke/cli.js",
