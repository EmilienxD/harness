{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 120,
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-managed-python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/address_issue_UserPromptSubmit_hook.py"
            ]
          },
          {
            "type": "command",
            "timeout": 60,
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--no-managed-python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/review_issue_UserPromptSubmit_hook.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "harness-report-gotchas-hook",
            "args": [
              "--claude"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
