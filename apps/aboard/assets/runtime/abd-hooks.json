{
  "SessionStart": [
    { "matcher": "startup|resume", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "__ABOARD_HOOK_SCRIPT__", "session-start"] }
    ] },
    { "matcher": "compact", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "__ABOARD_HOOK_SCRIPT__", "worker-reground"], "timeout": 120 }
    ] }
  ],
  "SessionEnd": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "__ABOARD_HOOK_SCRIPT__", "session-end"], "timeout": 10 }
    ] }
  ],
  "PostCompact": [
    { "matcher": "manual|auto", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "__ABOARD_HOOK_SCRIPT__", "worker-post-compact"] }
    ] }
  ],
  "Stop": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "__ABOARD_HOOK_SCRIPT__", "worker-stop"] }
    ] }
  ],
  "StopFailure": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "__ABOARD_HOOK_SCRIPT__", "worker-stop-failure"] }
    ] }
  ]
}
