{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aboard.dev/schemas/config.json",
  "title": "Aboard configuration",
  "description": "Sparse overrides for Aboard launches. Omitted settings use product defaults.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "autoRun": {
      "type": "object",
      "description": "Auto Run selects Claude when provider is omitted.",
      "properties": { "provider": { "enum": ["claude", "chatgpt"], "default": "claude" } }
    },
    "session": {
      "type": "object",
      "properties": { "stopWaitHours": { "type": "number", "minimum": 0 } }
    },
    "loop": {
      "type": "object",
      "properties": {
        "maxFeedback": { "type": "integer", "minimum": 0, "default": 3 },
        "maxImplementers": { "type": "integer", "minimum": 1, "default": 2 },
        "freshContextPercent": { "type": "number", "minimum": 0, "maximum": 100, "default": 65 }
      }
    },
    "providers": {
      "type": "object",
      "properties": {
        "claude": { "$ref": "#/$defs/claudeProvider" },
        "chatgpt": { "$ref": "#/$defs/chatgptProvider" }
      }
    },
    "grill": {
      "type": "object",
      "description": "Hosted Grill-Me board. Put code only in .harness/config.local.json or ~/.harness/config.json.",
      "properties": {
        "url": { "type": "string", "pattern": "^https?://[^/?#]+$" },
        "code": { "type": "string", "pattern": "^[0-9]{4}$" }
      }
    }
  },
  "$defs": {
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "claudeProfile": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "model": { "enum": ["inherit", "haiku", "sonnet", "opus"] },
        "effort": { "enum": ["inherit", "low", "medium", "high", "xhigh", "max"] },
        "deniedTools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "claudeExploreProfile": {
      "type": "object",
      "description": "Defaults to Haiku with low effort.",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "model": { "enum": ["inherit", "haiku", "sonnet", "opus"], "default": "haiku" },
        "effort": { "enum": ["inherit", "low", "medium", "high", "xhigh", "max"], "default": "low" }
      }
    },
    "claudeWorkerProfile": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "model": { "enum": ["by-difficulty", "haiku", "sonnet", "opus"], "default": "by-difficulty" },
        "effort": { "enum": ["by-difficulty", "low", "medium", "high", "xhigh", "max"], "default": "by-difficulty" },
        "deniedTools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "chatgptProfile": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "model": { "type": "string", "minLength": 1, "not": { "enum": ["haiku", "sonnet", "opus", "by-difficulty"] } },
        "effort": { "enum": ["inherit", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
      }
    },
    "chatgptExploreProfile": {
      "type": "object",
      "description": "Defaults to GPT-5.6 Luna with low effort.",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "model": { "type": "string", "minLength": 1, "not": { "enum": ["haiku", "sonnet", "opus", "by-difficulty"] }, "default": "gpt-5.6-luna" },
        "effort": { "enum": ["inherit", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"], "default": "low" }
      }
    },
    "chatgptWorkerProfile": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "model": { "anyOf": [{ "const": "by-difficulty" }, { "type": "string", "minLength": 1, "not": { "enum": ["haiku", "sonnet", "opus"] } }], "default": "by-difficulty" },
        "effort": { "enum": ["by-difficulty", "inherit", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"], "default": "by-difficulty" },
        "webSearch": { "enum": ["disabled", "cached", "indexed", "live"] },
        "subagents": { "enum": ["allowed", "denied"] }
      }
    },
    "claudeDelegationProfile": {
      "type": "object",
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "model": {"enum": ["inherit", "haiku", "sonnet", "opus", "by-difficulty"]},
        "effort": {"enum": ["inherit", "low", "medium", "high", "xhigh", "max"]},
        "deniedTools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "claudeDelegationExploreProfile": {
      "type": "object",
      "description": "Defaults to Haiku with low effort.",
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "model": {"enum": ["inherit", "haiku", "sonnet", "opus", "by-difficulty"], "default": "haiku"},
        "effort": {"enum": ["inherit", "low", "medium", "high", "xhigh", "max"], "default": "low"}
      }
    },
    "chatgptDelegationProfile": {
      "type": "object",
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "model": {"type": "string", "minLength": 1, "not": {"enum": ["haiku", "sonnet", "opus"]}},
        "effort": {"enum": ["inherit", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]}
      }
    },
    "chatgptDelegationExploreProfile": {
      "type": "object",
      "description": "Defaults to GPT-5.6 Luna with low effort.",
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "model": {"type": "string", "minLength": 1, "not": {"enum": ["haiku", "sonnet", "opus"]}, "default": "gpt-5.6-luna"},
        "effort": {"enum": ["inherit", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"], "default": "low"}
      }
    },
    "claudeDelegations": {
      "type": "object",
      "properties": {
        "explore": { "$ref": "#/$defs/claudeDelegationExploreProfile" },
        "prototype": { "$ref": "#/$defs/claudeDelegationProfile" },
        "websearch": { "$ref": "#/$defs/claudeDelegationProfile" },
        "brainstorm": { "$ref": "#/$defs/claudeDelegationProfile" },
        "address": { "$ref": "#/$defs/claudeDelegationProfile" },
        "review": { "$ref": "#/$defs/claudeDelegationProfile" },
        "general": { "$ref": "#/$defs/claudeDelegationProfile" },
        "loop": { "$ref": "#/$defs/claudeDelegationProfile" }
      }
    },
    "chatgptDelegations": {
      "type": "object",
      "properties": {
        "explore": { "$ref": "#/$defs/chatgptDelegationExploreProfile" },
        "prototype": { "$ref": "#/$defs/chatgptDelegationProfile" },
        "websearch": { "$ref": "#/$defs/chatgptDelegationProfile" },
        "brainstorm": { "$ref": "#/$defs/chatgptDelegationProfile" },
        "address": { "$ref": "#/$defs/chatgptDelegationProfile" },
        "review": { "$ref": "#/$defs/chatgptDelegationProfile" },
        "general": { "$ref": "#/$defs/chatgptDelegationProfile" },
        "loop": { "$ref": "#/$defs/chatgptDelegationProfile" }
      }
    },
    "claudeProvider": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "interactive": { "$ref": "#/$defs/claudeProfile" },
        "delegations": { "$ref": "#/$defs/claudeDelegations" },
        "autoRun": {
          "type": "object",
          "properties": {
            "explore": { "$ref": "#/$defs/claudeExploreProfile" },
            "address": { "$ref": "#/$defs/claudeWorkerProfile" },
            "review": { "$ref": "#/$defs/claudeWorkerProfile" }
          }
        }
      }
    },
    "chatgptProvider": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "interactive": { "$ref": "#/$defs/chatgptProfile" },
        "delegations": { "$ref": "#/$defs/chatgptDelegations" },
        "autoRun": {
          "type": "object",
          "properties": {
            "explore": { "$ref": "#/$defs/chatgptExploreProfile" },
            "address": { "$ref": "#/$defs/chatgptWorkerProfile" },
            "review": { "$ref": "#/$defs/chatgptWorkerProfile" }
          }
        }
      }
    }
  }
}
