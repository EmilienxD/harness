# Copy to .env.development.local for a local Supabase stack.
HARNESS_GRILL_URL=http://localhost:55430
HARNESS_GRILL_CODE=1234
HARNESS_GRILL_SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-separate-long-random-secret
# Start Supabase with `npx supabase start`, then get its key from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SECRET_KEY=sb_secret_replace_me
