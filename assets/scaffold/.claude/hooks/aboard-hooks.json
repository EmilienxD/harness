{
  "UserPromptSubmit": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "manager-prompt"], "timeout": 60 }
    ] }
  ],
  "SessionStart": [
    { "matcher": "startup|resume|clear|compact|fork", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "manager-brief-git"], "timeout": 120 },
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "manager-brief-github"], "timeout": 120 },
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "manager-brief-fleet"], "timeout": 120 },
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "manager-brief-todo"], "timeout": 120 }
    ] },
    { "matcher": "compact", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "worker-reground"], "timeout": 120 }
    ] }
  ],
  "SubagentStart": [
    { "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "worker-subagent-start"] } ] }
  ],
  "SubagentStop": [
    { "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "worker-subagent-stop"] } ] }
  ],
  "PostToolUse": [
    { "matcher": "Agent", "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "worker-agent-tool"] } ] }
  ],
  "PostCompact": [
    { "matcher": "manual|auto", "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "worker-post-compact"] } ] }
  ],
  "Stop": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "manager-stop"], "timeout": 3600 },
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "worker-stop"] }
    ] }
  ],
  "StopFailure": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "${CLAUDE_PROJECT_DIR}/.claude/hooks/aboard_hook.py", "worker-stop-failure"] }
    ] }
  ]
}
