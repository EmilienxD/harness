{
  "UserPromptSubmit": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "manager-prompt"], "timeout": 60 }
    ] }
  ],
  "SessionStart": [
    { "matcher": "startup|resume", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "session-start"] }
    ] },
    { "matcher": "startup|resume|clear|compact|fork", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "manager-brief"], "timeout": 120 }
    ] },
    { "matcher": "compact", "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "worker-reground"], "timeout": 120 }
    ] }
  ],
  "SessionEnd": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "session-end"], "timeout": 10 }
    ] }
  ],
  "SubagentStart": [
    { "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "worker-subagent-start"] } ] }
  ],
  "SubagentStop": [
    { "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "worker-subagent-stop"] } ] }
  ],
  "PostToolUse": [
    { "matcher": "Agent", "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "worker-agent-tool"] } ] },
    { "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "report-delivery"], "timeout": 120 } ] },
    { "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "manager-roadmap"], "timeout": 60 } ] }
  ],
  "PostCompact": [
    { "matcher": "manual|auto", "hooks": [ { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "worker-post-compact"] } ] }
  ],
  "Stop": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "report-stop"], "timeout": 86400 },
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "worker-stop"] }
    ] }
  ],
  "StopFailure": [
    { "hooks": [
      { "type": "command", "command": "uv", "args": ["run", "--no-project", "--no-managed-python", "${CLAUDE_PROJECT_DIR}/.aboard/scripts/aboard_hook.py", "worker-stop-failure"] }
    ] }
  ]
}
